{
  "expo": {
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#ffffff",
        "foregroundImage": "./assets/images/adaptive-icon.png"
      },
      "edgeToEdgeEnabled": true,
      "gradleVersion": "8.10.2",
      "package": "com.campusaccess.portal",
      "permissions": ["INTERNET", "ACCESS_NETWORK_STATE"]
    },
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "2e18b548-605a-4631-bea5-090336f24033"
      },
      "router": {}
    },
    "icon": "./assets/images/icon.png",
    "ios": {
      "supportsTablet": true
    },
    "name": "Campus Access Portal",
    "newArchEnabled": true,
    "orientation": "portrait",
    "owner": "eksel700s-team",
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ],
    "scheme": "campusaccess",
    "slug": "campus-access",
    "userInterfaceStyle": "automatic",
    "version": "1.0.0",
    "web": {
      "bundler": "metro",
      "favicon": "./assets/images/favicon.png",
      "output": "single"
    }
  }
}
